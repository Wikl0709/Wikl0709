ription\":\"\",\"fileName\":\"Netflix Becomes a Broadway Producer With Peter Morgan’s Patriots.txt\",\"folder\":\"C:\\\\Users\\\\XiaoXinPro 16 IAH\\\\Desktop\\\\LRIA_llm_eval\\\\eval\\\\Quantum_e2e_v20251106\\\\Bvt1110\\\\bvtfiles\",\"id\":1987776372025724928,\"isDeleted\":0,\"isTmpFile\":false,\"labelNameList\":[],\"lastModifyTime\":\"2025-09-17T09:46:00\",\"md5\":\"ab84c46eaa62a18048fb0241446da4ca\",\"path\":\"C:\\\\Users\\\\XiaoXinPro 16 IAH\\\\Desktop\\\\LRIA_llm_eval\\\\eval\\\\Quantum_e2e_v20251106\\\\Bvt1110\\\\bvtfiles\\\\Netflix Becomes a Broadway Producer With Peter Morgan’s Patriots.txt\",\"priority\":9,\"score\":0.0,\"status\":\"ADDED\",\"tokenNum\":0,\"uriPath\":\"\"}]"}}
